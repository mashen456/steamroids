# Copy this file to `.env` (git-ignored) and fill in DEDICATED test accounts.
# These variables drive the opt-in live integration tests.
#
#   cargo test --test live_auth    -- --include-ignored --nocapture
#   cargo test --test live_friends -- --include-ignored --nocapture
#
# Never use a primary account: Steam can flag or lock accounts used for
# automated logins, and live_friends MUTATES both accounts (it makes them
# friends, sets a nickname, sends a real chat message, and creates and deletes
# a friend group).
#
# NOT fully throwaway-able. Steam blocks "limited" accounts (under the $5 / £5
# lifetime spend threshold) from SENDING friend invites, and live_friends has
# both accounts add each other. Account A needs the threshold met for certain.
# Account B may get away without it, since by the time it adds A there is
# already a pending invite and accepting is allowed, but do not count on it.
# See https://support.steampowered.com/kb/3330-IAGK-7663/limited-user-accounts
#
# A missing variable makes the affected test SKIP, not fail, so a green local
# run does not by itself mean the live paths were exercised. Read the SKIP
# lines in the output. CI sets STEAM_LIVE_REQUIRED=1 to turn those skips into
# hard failures; leave it unset locally.
#
# In CI the same variables come from GitHub Actions encrypted secrets, never
# from this file.

# --- Account A: with mobile 2FA (password + authenticator shared secret) ---
STEAM_TEST_2FA_ACCOUNT=
STEAM_TEST_2FA_PASSWORD=
# base64 mobile-authenticator shared secret:
STEAM_TEST_2FA_SHARED_SECRET=

# --- Account B: no 2FA, password only ---
# For a green "login OK" this account must have Steam Guard fully DISABLED.
# If it still has email Guard, the test soft-skips (email codes aren't wired up).
# This account is also the friend-target for the friends-API live test
# (`tests/live_friends.rs`). That test logs both accounts in and bootstraps the
# friendship over the live sessions, so no manual friending is needed, but see
# the limited-account note at the top: the adds only succeed if the accounts
# are past Steam's spend threshold.
STEAM_TEST_PLAIN_ACCOUNT=
STEAM_TEST_PLAIN_PASSWORD=

# --- Optional: CS2 Game Coordinator scan (cs2_profile_scan) ---
# An account that OWNS / has launched CS2, so its Game Coordinator welcomes us.
# Must be a DIFFERENT account than STEAM_TEST_2FA_* (concurrent logins with the
# same authenticator would reuse the same 2FA code). If unset, cs2_profile_scan
# falls back to the plain account and soft-skips when the GC doesn't welcome.
# _SHARED_SECRET is optional (set it if this account has mobile 2FA).
STEAM_TEST_CS2_ACCOUNT=
STEAM_TEST_CS2_PASSWORD=
STEAM_TEST_CS2_SHARED_SECRET=
# Optional: scan THIS player's profile (SteamID64) instead of the bot's own —
# point it at a known active player to guarantee non-empty level/XP data.
STEAM_TEST_CS2_TARGET_ID=

# --- Optional: refresh-token reuse flow ---
# Obtain one from a successful password run (printed by example 04).
STEAM_TEST_REFRESH_TOKEN=

# --- Optional: route every live call through a proxy ---
#   socks5://user:pass@host:1080  |  http://user:pass@host:8080
STEAM_TEST_PROXY_URL=
